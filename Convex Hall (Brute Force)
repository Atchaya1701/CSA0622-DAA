#include <stdio.h>

struct Point
{
    int x, y;
};

int main()
{
    struct Point p[20];
    int n, i, j, k;
    int count = 0;

    printf("Enter the number of points: ");
    scanf("%d", &n);

    printf("Enter the coordinates (x y):\n");
    for(i = 0; i < n; i++)
        scanf("%d %d", &p[i].x, &p[i].y);

    printf("\nConvex Hull Edges:\n");

    for(i = 0; i < n; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            int pos = 0, neg = 0;

            for(k = 0; k < n; k++)
            {
                count++;

                int value = (p[j].x - p[i].x) * (p[k].y - p[i].y)
                          - (p[j].y - p[i].y) * (p[k].x - p[i].x);

                if(value > 0)
                    pos++;
                else if(value < 0)
                    neg++;
            }

            if(pos == 0 || neg == 0)
            {
                printf("(%d,%d) -> (%d,%d)\n",
                       p[i].x, p[i].y,
                       p[j].x, p[j].y);
            }
        }
    }

    printf("\nTotal Operations = %d", count);

    printf("\n\nTime Complexity:");
    printf("\nBest Case    : O(n^3)");
    printf("\nAverage Case : O(n^3)");
    printf("\nWorst Case   : O(n^3)");

    return 0;
}
