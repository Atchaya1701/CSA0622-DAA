#include <stdio.h>
#include <string.h>

int main() {
    char text[100], pattern[50];
    int i, j, found = 0;

    printf("Enter text: ");
    gets(text);

    printf("Enter pattern: ");
    gets(pattern);

    for (i = 0; i <= strlen(text) - strlen(pattern); i++) {
        for (j = 0; j < strlen(pattern); j++) {
            if (text[i + j] != pattern[j])
                break;
        }

        if (j == strlen(pattern)) {
            printf("Pattern found at position %d", i);
            found = 1;
            break;
        }
    }

    if (!found)
        printf("Pattern not found");

    return 0;
}
