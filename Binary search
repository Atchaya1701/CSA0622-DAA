#include <stdio.h>

int main()
{
    int a[100], n, key;
    int low, high, mid, i;
    int comparisons = 0;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    printf("Enter the sorted elements:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter the element to search: ");
    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while(low <= high)
    {
        comparisons++;
        mid = (low + high) / 2;

        if(a[mid] == key)
        {
            printf("\nElement found at position %d\n", mid + 1);
            printf("Total Comparisons = %d\n", comparisons);

            if(comparisons == 1)
            {
                printf("\nCase            : Best Case");
                printf("\nTime Complexity : O(1)");
            }
            else
            {
                printf("\nCase            : Average Case");
                printf("\nTime Complexity : O(log n)");
            }

            return 0;
        }
        else if(key < a[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }

    printf("\nElement not found\n");
    printf("Total Comparisons = %d\n", comparisons);
    printf("\nCase            : Worst Case");
    printf("\nTime Complexity : O(log n)");

    return 0;
}
